# Sports Auction Platform - Environment Variables
# Copy this file to .env and adjust values for your environment

# PostgreSQL Database Connection URL (Required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_auction

# Backend Server Port (Optional, defaults to 8080)
PORT=8080

# JWT Authentication Secret (Optional for development, set for production)
JWT_SECRET=super-secret-jwt-key-change-me-in-production

# Frontend Settings (Optional)
# BASE_PATH=/
# API_URL=http://localhost:8080
